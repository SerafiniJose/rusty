<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.rusty.app">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Remote control API. connectedDevice (prerequisite CHANGE_WIFI_MULTICAST_STATE, declared
         above) is deliberately NOT mediaPlayback: it is not among the foreground-service types
         Android 15+ forbids starting from BOOT_COMPLETED, so the API can come up on boot.
         WRITE_SETTINGS is the appop the user grants to let remote brightness move the DEVICE's
         brightness instead of only this app's window; without it the API reports mode "window". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Android TV (NVIDIA Shield) support. Declaring these features as not-required keeps the
         app installable on phones/tablets while allowing it to run on touchless TV hardware.
         Android implicitly requires a touchscreen otherwise, which excludes TV devices. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!-- Backups are off because they are how credentials leave the device: `adb backup` and cloud
         auto-backup copy shared_prefs verbatim, and an encrypted secrets file restored onto another
         device is undecryptable anyway (its master key is device-bound). The app stores only
         settings a user can re-enter, so there is nothing worth backing up. -->
    <application
        android:name=".RustyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Rusty">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Makes the app appear as a tile on the Android TV / Shield home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LyricsActivity"
            android:exported="false"
            android:theme="@style/Theme.Rusty" />

        <service
            android:name=".SpotifyService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name=".renderer.MediaRendererService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name=".ControlService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>