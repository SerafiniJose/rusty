<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.rusty.app">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Remote control API. connectedDevice (prerequisite CHANGE_WIFI_MULTICAST_STATE, declared
         above) is deliberately NOT mediaPlayback: it is not among the foreground-service types
         Android 15+ forbids starting from BOOT_COMPLETED, so the API can come up on boot.
         WRITE_SETTINGS is the appop the user grants to let remote brightness move the DEVICE's
         brightness instead of only this app's window; without it the API reports mode "window". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Camera share: this device's own camera offered to other Rusty devices as an RTSP
         stream on the LAN. The stream carries a password only when Remote Control's password is
         switched on — with it off the API is open to the LAN and so is this, which is the same
         posture as every other endpoint. The camera foreground-service type is the one Android
         14+ refuses to start from the background, which is why HomeActivity.onStart — never
         BootReceiver — is its start path. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- In-app update install (About sheet + remote-control page). Never silent: this only
         lets the app hand a downloaded APK to the system installer, which still asks for
         confirmation on the device screen (plus a one-time "allow from this source" grant). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android TV (NVIDIA Shield) support. Declaring these features as not-required keeps the
         app installable on phones/tablets while allowing it to run on touchless TV hardware.
         Android implicitly requires a touchscreen otherwise, which excludes TV devices. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!-- Camera share is optional, and it takes BOTH lines to say so. `android.permission.CAMERA`
         implicitly adds `<uses-feature android:name="android.hardware.camera"
         android:required="true">` — a BACK-facing camera — and declaring `camera.any` does not
         cancel that, because it is a different feature name. Only the explicit not-required
         `android.hardware.camera` below keeps the app installable on the camera-less and
         front-camera-only hardware it mostly runs on (Shield, tablets, Echo Shows). Verify after
         any change to this block with
         `aapt2 dump badging app-debug.apk | grep camera`: BOTH names must come back as
         `uses-feature-not-required`. The service checks for a real front/back lens at start and
         reports the share as unsupported when there is none. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
    </queries>

    <!-- Backups are off because they are how credentials leave the device: `adb backup` and cloud
         auto-backup copy shared_prefs verbatim, and an encrypted secrets file restored onto another
         device is undecryptable anyway (its master key is device-bound). The app stores only
         settings a user can re-enter, so there is nothing worth backing up. -->
    <application
        android:name=".RustyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Rusty">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Makes the app appear as a tile on the Android TV / Shield home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LyricsActivity"
            android:exported="false"
            android:theme="@style/Theme.Rusty" />

        <service
            android:name=".SpotifyService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name=".renderer.MediaRendererService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name=".ControlService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <service
            android:name=".CameraShareService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- PackageInstaller status callbacks for in-app updates. Manifest-declared because
             targetSdk 36 doesn't deliver the system installer's broadcasts to runtime-registered
             non-exported receivers; non-exported because only our own explicit PendingIntent
             (fired by the system install service) ever targets it. -->
        <receiver
            android:name=".ApkInstall$ResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>