<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the device. `android:allowBackup="false"` already covers cloud backup on every
   API level; this file exists for the one channel that flag does NOT control on Android 12+,
   device-to-device transfer. Both sections are excluded wholesale rather than selectively: the
   app persists only re-enterable settings, and the one item that must never be copied — the
   encrypted secrets file — would be useless on the target device anyway, since its master key is
   bound to this device's KeyStore. Restoring it would look like a configured app that silently
   fails to authenticate.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
