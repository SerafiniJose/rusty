<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait variant of the DLNA Player face. Identical view IDs to res/layout/ (the landscape
  variant) so DlnaPlayerFragment binds unchanged; Android re-inflates the right one per
  orientation on the rotation-triggered recreate. The playing group is STACKED (cover on top,
  sized by width and capped) rather than split, mirroring layout-port/fragment_spotify.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dlnaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <dev.rusty.app.AmbientMeshView
        android:id="@+id/dlnaMesh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <dev.rusty.app.GrainView
        android:id="@+id/dlnaGrain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dlnaContentLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/dlnaIdentityRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dlnaIdentityDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/dlnaIdentityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_semibold"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="· DLNA"
                android:textColor="@color/muted_dim"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dlnaStatusBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/ic_mdi_dlna" />

            <TextView
                android:id="@+id/dlnaStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/hanken_semibold"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/dlnaStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/hanken_regular"
                android:gravity="center"
                android:textColor="@color/muted_dim"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dlnaStartButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Start"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dlnaAlbumArtCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="48dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dlnaIdentityRow"
            app:layout_constraintWidth_max="300dp">

            <ImageView
                android:id="@+id/dlnaAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_album_art_placeholder"
                android:contentDescription="Album art"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/dlnaArtGlyph"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/ic_mdi_dlna" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/dlnaNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dlnaAlbumArtCard"
            app:layout_constraintVertical_bias="0.0">

            <TextView
                android:id="@+id/dlnaEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_semibold"
                android:letterSpacing="0.18"
                android:text="NOW PLAYING"
                android:textColor="@color/accent_fallback"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlnaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/bricolage_bold"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/dlnaArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/dlnaAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/muted_dim"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/dlnaProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@null"
                android:focusable="false"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/bg_dlna_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/bg_dlna_seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dlnaElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/hanken_regular"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dlnaDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/dlnaStop"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Stop"
                    android:foreground="@drawable/bg_tv_focus"
                    android:nextFocusRight="@id/dlnaPlayPause"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop" />

                <ImageButton
                    android:id="@+id/dlnaPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="22dp"
                    android:background="@drawable/bg_playpause_button"
                    android:contentDescription="Play or pause"
                    android:foreground="@drawable/bg_tv_focus"
                    android:nextFocusLeft="@id/dlnaStop"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
