<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad focus ring for the settings tab strip. The stock TabView focus highlight is a dark
     scrim that is invisible on this dark card, which left Android TV users unable to tell the
     strip had focus at all; this draws the same brand-green ring every other control uses.
     Set as the TabLayout's tabBackground, so it replaces (not overlays) that scrim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A view keeps isFocused() while its window loses focus to a dialog, so without this the
         ring behind an open card stays lit and the screen shows two focus rings at once. -->
    <item android:state_window_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_fallback" />
            <solid android:color="#221ED760" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
