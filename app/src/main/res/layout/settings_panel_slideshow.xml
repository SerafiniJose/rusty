<?xml version="1.0" encoding="utf-8"?>
<!-- Slideshow settings panel: connection, filters, display.

     Root is a plain LinearLayout like every other settings panel — bottom_sheet_settings.xml
     already hosts the panel container inside a NestedScrollView, so this (long) panel scrolls
     with the rest of the card. A nested ScrollView here would fight that outer scroller.

     Three collapsible sections (Server / Filters / Display), each a header (include) + body
     LinearLayout toggled by SlideshowSettingsPanel via CollapsibleSection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- SERVER -->

    <include
        android:id="@+id/headSsServer"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySsServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColorHint="@color/muted_dim"
            app:boxStrokeColor="@color/accent_fallback"
            app:hintTextColor="@color/muted_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImmichUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:hint="http://192.168.1.10:2283"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColorHint="@color/muted_dim"
            app:boxStrokeColor="@color/accent_fallback"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/muted_dim"
            app:hintTextColor="@color/muted_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImmichApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:hint="API key (Immich → Account settings → API keys)"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImmichSave"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Save" />
        </LinearLayout>

        <!-- Shown only while the saved address is plain http (see SlideshowSettings.isCleartext):
             the API key travels unencrypted on every request. Advisory, not a block — self-hosted
             Immich on a LAN usually has no certificate. -->
        <TextView
            android:id="@+id/tvImmichCleartextWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/hanken_regular"
            android:text="This server uses http, so the API key is sent unencrypted over your network. Use https if your server supports it."
            android:textColor="@color/muted_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvImmichFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/hanken_regular"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- FILTERS -->

    <include
        android:id="@+id/headSsFilters"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySsFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvImmichFiltersHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/hanken_regular"
            android:text="Leave everything unselected to show your whole library."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- One summary row per category. Each opens ImmichFilterPickerDialog; the chip walls they
             replace could not scale past MAX_CHIPS and had no search. Hidden until the panel knows
             the category's state (see SlideshowSettingsPanel.renderRows). -->
        <include
            android:id="@+id/rowImmichAlbums"
            layout="@layout/view_immich_filter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <include
            android:id="@+id/rowImmichPeople"
            layout="@layout/view_immich_filter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/rowImmichTags"
            layout="@layout/view_immich_filter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- DISPLAY -->

    <include
        android:id="@+id/headSsDisplay"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySsDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Interval: label + current value on the left, stepped slider on the right (mirrors the
             screensaver "Start after (idle)" row). 7 positions = SlideshowSettings.INTERVAL_STEPS. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Change photo every"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvImmichIntervalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="45 seconds"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderImmichInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="3"
                android:valueFrom="0"
                android:valueTo="6"
                app:haloColor="@color/accent_fallback"
                app:labelBehavior="gone"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Clock overlay"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Show the time and date over the photo"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchImmichClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Photo info"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Date, place and people on each photo"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchImmichInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Zoom effect"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Slow Ken Burns motion — needs system animations enabled"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchImmichZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Split view"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Two portrait photos side by side"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchImmichSplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
