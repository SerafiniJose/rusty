<?xml version="1.0" encoding="utf-8"?>
<!-- Card picker for one filter category. Height is set in code from the window bounds
     (~80%) so the RecyclerView scrolls inside the card; adjustResize keeps Done above
     the IME. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_popup_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/hanken_semibold"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPickerSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/hanken_regular"
            android:textColor="@color/accent_fallback"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:focusable="true"
            android:clickable="true"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/muted_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPickerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_picker_search"
        android:fontFamily="@font/hanken_regular"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/hanken_regular"
        android:text="No matches."
        android:textColor="@color/muted_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickerItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickerDone"
        style="@style/Widget.Rusty.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:foreground="@drawable/bg_tv_focus"
        android:text="Done" />
</LinearLayout>
