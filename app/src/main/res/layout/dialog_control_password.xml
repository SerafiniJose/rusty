<?xml version="1.0" encoding="utf-8"?>
<!-- Set/change the control API password. Masked input with the HA sign-in's outlined box and
     eye toggle, so every password field in the app is the same physical part; Save commits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hanken_semibold"
        android:text="Control page password"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/muted_dim"
        app:boxStrokeColor="@color/accent_fallback"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/muted_dim"
        app:hintTextColor="@color/muted_dim">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etControlPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_regular"
            android:hint="Password"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvControlPasswordError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/hanken_regular"
        android:textColor="@color/dot_red"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnControlPasswordCancel"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnControlPasswordSave"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Save" />
    </LinearLayout>
</LinearLayout>
