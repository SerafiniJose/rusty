<?xml version="1.0" encoding="utf-8"?>
<!-- One ONVIF discovery result. Tapping asks for credentials, resolves the stream, and pre-fills
     the add dialog. A camera already matched by host (see CameraSettingsPanel.hostOf) is dimmed
     and shows "Added" instead of accepting a tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingHorizontal="@dimen/tv_focus_ring_gap"
    android:layout_marginHorizontal="@dimen/tv_focus_ring_gap_offset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_tv_focus"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCamDiscRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_medium"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCamDiscRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_regular"
            android:maxLines="1"
            android:textColor="@color/muted_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCamDiscRowAdded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/hanken_regular"
        android:text="Added"
        android:textColor="@color/muted_dim"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
