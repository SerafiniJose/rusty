<?xml version="1.0" encoding="utf-8"?>
<!-- Camera settings tab: two collapsible sections (Cameras / Grid; ONVIF discovery lives in the Add camera card), same shape
     as SlideshowSettingsPanel's Server/Filters/Display. Root is a plain LinearLayout — the panel
     container already scrolls (bottom_sheet_settings.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- CAMERAS -->

    <include
        android:id="@+id/headCamCameras"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodyCamCameras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/camReorderStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_mode_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hanken_regular"
                android:text="Drag a handle, or select a camera and move it with ▲ ▼. The wall follows as you go."
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamReorderDone"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:foreground="@drawable/bg_tv_focus"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Done" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/camCameraList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvCamCameraListEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/hanken_regular"
            android:text="No cameras yet."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- Action buttons BELOW the list (Add opens dialog_camera_add.xml; Reorder flips the list
             into CameraReorderMode). Same square Secondary buttons as every dialog footer. While
             reordering the bar hides and the mode strip above the list takes over, so the hint and
             Done stay on screen however many cameras there are. -->
        <LinearLayout
            android:id="@+id/camActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamAdd"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Add camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamReorder"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Reorder" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <!-- GRID: layout, page rotation (paging only), refresh. Ordered by how much each changes the wall. -->

    <include
        android:id="@+id/headCamBehavior"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodyCamBehavior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Layout: every camera on one screen, or fixed pages. Not a RadioGroup (Flow-positioned
             radios are not its direct children); exclusivity lives in the binder. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_medium"
            android:text="Layout"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_regular"
            android:text="All: tiles shrink so every camera fits. Pages: bigger tiles, flip with ◀ ▶."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="rbCamLayoutAll,rbCamLayout4,rbCamLayout6,rbCamLayout8"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="20dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="6dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbCamLayoutAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="All in one view"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 4"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 6"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 8"
                android:textColor="@color/ink" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Page rotation: only while a Pages option is selected (binder toggles visibility). Indented
             under Layout because it is a property of paging. -->
        <LinearLayout
            android:id="@+id/rowCamPageRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Page rotation"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCamPageRotationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Every 10 s"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCamPageRotation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="3"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:haloColor="@color/accent_fallback"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <!-- Refresh: label + cadence ("Every 30 s"), compact slider on the right (Spotify Bitrate idiom).
             Discrete: slider value = index into CameraBehaviorPrefs.REFRESH_STEPS_S (floor 30 s, see there). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Refresh"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCamRefreshValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Every 30 s"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCamRefresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:haloColor="@color/accent_fallback"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
