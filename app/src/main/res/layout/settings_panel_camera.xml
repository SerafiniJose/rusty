<?xml version="1.0" encoding="utf-8"?>
<!-- Camera settings tab: two collapsible sections (Cameras / Grid; ONVIF discovery lives in the Add camera card), same shape
     as SlideshowSettingsPanel's Server/Filters/Display. Root is a plain LinearLayout — the panel
     container already scrolls (bottom_sheet_settings.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- CAMERAS -->

    <include
        android:id="@+id/headCamCameras"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodyCamCameras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/camReorderStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_mode_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hanken_regular"
                android:text="Drag a handle, or select a camera and move it with ▲ ▼. The wall follows as you go."
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamReorderDone"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:foreground="@drawable/bg_tv_focus"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Done" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/camCameraList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvCamCameraListEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/hanken_regular"
            android:text="No cameras yet."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- Action buttons BELOW the list (Add opens dialog_camera_add.xml; Reorder flips the list
             into CameraReorderMode). Same square Secondary buttons as every dialog footer. While
             reordering the bar hides and the mode strip above the list takes over, so the hint and
             Done stay on screen however many cameras there are. -->
        <LinearLayout
            android:id="@+id/camActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamAdd"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Add camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamReorder"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Reorder" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <!-- GRID: layout, page rotation (paging only), refresh. Ordered by how much each changes the wall. -->

    <include
        android:id="@+id/headCamBehavior"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodyCamBehavior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Layout: every camera on one screen, or fixed pages. Not a RadioGroup (Flow-positioned
             radios are not its direct children); exclusivity lives in the binder. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_medium"
            android:text="Layout"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_regular"
            android:text="All: tiles shrink so every camera fits. Pages: bigger tiles, flip with ◀ ▶."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="rbCamLayoutAll,rbCamLayout4,rbCamLayout6,rbCamLayout8"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="20dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="6dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbCamLayoutAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="All in one view"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 4"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 6"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCamLayout8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pages of 8"
                android:textColor="@color/ink" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Page rotation: only while a Pages option is selected (binder toggles visibility). Indented
             under Layout because it is a property of paging. -->
        <LinearLayout
            android:id="@+id/rowCamPageRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Page rotation"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCamPageRotationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Every 10 s"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCamPageRotation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="3"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:haloColor="@color/accent_fallback"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface_border" />

        <!-- Refresh: label + cadence ("Every 30 s"), compact slider on the right (Spotify Bitrate idiom).
             Discrete: slider value = index into CameraBehaviorPrefs.REFRESH_STEPS_S (floor 30 s, see there). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Refresh"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCamRefreshValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Every 30 s"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCamRefresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="5"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:haloColor="@color/accent_fallback"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <!-- SHARE: stream this device's own camera to other Rusty devices / HA / VLC. Remote Control
         is a prerequisite (its service owns the mDNS advertisement and the snapshot endpoint), so
         the switch disables itself and says so while that is off — see CameraShareSettingsModel. -->
    <include
        android:id="@+id/headCamShare"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodyCamShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Label column weighted, switch wrap_content: the status line is a whole sentence
             ("Turn on Remote Control in General settings first") and must wrap, not push the
             switch off a portrait sheet. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Share this device's camera"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCamShareStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Off"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCamShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/hanken_regular"
            android:text="Other Rusty devices find it in their camera scan. Protected by the Remote Control password when one is set. The camera only turns on while someone is watching."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- Shown while sharing is on with no API password: the stream and the snapshot endpoint
             are then open to anyone on the LAN. Not a block — the same posture as the rest of the
             control API — but never a silent one. -->
        <TextView
            android:id="@+id/tvCamShareWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/hanken_regular"
            android:textColor="@color/dot_amber"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Only on hardware with both facings (CameraShareSettingsModel.showLensPicker). -->
        <LinearLayout
            android:id="@+id/rowCamShareLens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Lens"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCamShareFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Front"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Back"
                    android:textColor="@color/ink" />
            </RadioGroup>
        </LinearLayout>

        <!-- A ceiling, not a promise: a camera that does not offer the chosen size streams the
             largest one it does offer below it (CameraCapturePipeline.pickSize). Label above the
             control, never beside it, so a narrow card in portrait cannot push the two together. -->
        <LinearLayout
            android:id="@+id/rowCamShareQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Resolution"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgCamShareQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCamShareLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="480p"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="720p"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="1080p"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <!-- Quality is the bitrate in the user's words; Frame rate is enforced at the encoder's
                 input surface (CameraCapturePipeline.encoderFormat). Both rows follow the
                 Resolution row's pattern: label above, radios below, so a portrait card never
                 pushes label and control together. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/hanken_medium"
                android:text="Quality"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgCamShareTier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCamShareBasic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Basic"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareGood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Good"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Best"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/hanken_medium"
                android:text="Frame rate"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgCamShareFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCamShareFps10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="10 fps"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareFps15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="15 fps"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbCamShareFps30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="30 fps"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <!-- The words chosen and the honest number behind them (CameraShareSettingsModel.encodingHint). -->
            <TextView
                android:id="@+id/tvCamShareEncodingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/hanken_regular"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />

            <!-- Wi-Fi headroom, measured on THIS device (WifiLinkProbe -> networkAdvice). Shown only
                 while the share is on and can run, and only on Wi-Fi. Colour carries the level. -->
            <TextView
                android:id="@+id/tvCamShareAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/hanken_regular"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCamShareAdviceDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/hanken_regular"
                tools:text="Checks this device's Wi-Fi only. A viewer on weak Wi-Fi still stutters."
                android:textColor="@color/muted_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Address label + value hide together: with nothing listening there is no address to
             show. Deliberately NOT textIsSelectable — that makes a TextView focusable and drops a
             D-pad dead end into the section (the sheet has to stay walkable on a touchless TV). -->
        <LinearLayout
            android:id="@+id/rowCamShareUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Stream address"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCamShareUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>