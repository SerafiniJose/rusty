<?xml version="1.0" encoding="utf-8"?>
<!-- Single-choice picker for the announcement voice, plus the downloadable Piper catalog the
     control page shows. Height is set in code from the window bounds (~80%) so both sections
     scroll inside the card, like the Immich filter picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_popup_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/hanken_semibold"
            android:text="Announcement voice"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnVoiceClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/muted_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llVoiceRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvVoiceCatalogHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/hanken_semibold"
                android:letterSpacing="0.08"
                android:text="GET MORE VOICES"
                android:textAllCaps="true"
                android:textColor="@color/muted_dim"
                android:textSize="11sp" />

            <!-- Quality tier as filter chips sitting directly on the catalog they narrow — the
                 tier persists (the old Voice-quality row's pref exactly) and only the catalog
                 filters: installed voices above never hide. Horizontal scroll, not wrap, so a
                 narrow card keeps one tidy row and the D-pad walks it left-to-right. -->
            <HorizontalScrollView
                android:id="@+id/hsVoiceQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llVoiceQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvVoiceQualityHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/hanken_regular"
                android:textColor="@color/muted_dim"
                android:textSize="12sp" />

            <!-- Each entry is an action button plus ALWAYS-visible size/license/attribution:
                 every Piper voice carries its own dataset terms, and this is where the user
                 reads them before deciding to download. -->
            <LinearLayout
                android:id="@+id/llVoiceCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned below the scroller so progress stays visible while the list scrolls. -->
    <ProgressBar
        android:id="@+id/pbVoiceDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/accent_fallback"
        android:max="100"
        android:progressTint="@color/accent_fallback"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvVoiceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />
</LinearLayout>
