<?xml version="1.0" encoding="utf-8"?>
<!-- Three collapsible sections (Receiver / Display / During messages), each a header (include)
     + body — the same idiom as the Slideshow and Home Assistant panels. Collapsed bodies are GONE,
     so their rows drop out of D-pad focus order automatically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- RECEIVER -->

    <include
        android:id="@+id/headSpReceiver"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySpReceiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Receiver power: live status sub-line + a Stop/Start toggle, mirroring the name+Change row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Receiver"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvReceiverStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Running · listening for Spotify"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleService"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Stop" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <!-- Receiver name: one row showing the current name + a Change button that reveals the editor. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Receiver name"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvReceiverNameValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Rusty Speaker"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeName"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Change" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowReceiverNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReceiverName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColorHint="@color/muted_dim"
                app:boxStrokeColor="@color/accent_fallback"
                app:hintTextColor="@color/muted_dim">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReceiverName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/hanken_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Save"
                android:textColor="@color/white"
                app:backgroundTint="@color/accent_fallback" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <!-- Bitrate: label + current value on the left, a compact horizontal bar on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Bitrate"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvBitrateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="160 kbps · balanced"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBitrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="2"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:haloColor="@color/accent_fallback"
                app:thumbColor="@color/accent_fallback"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/muted_dim"
                app:trackColorActive="@color/accent_fallback"
                app:trackColorInactive="@color/surface_border" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettingsFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textColor="@color/muted_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- DISPLAY -->

    <include
        android:id="@+id/headSpDisplay"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySpDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Show Canvas videos"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Play looping artist video art when available"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCanvas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <!-- Playback takeover: what a cast starting is allowed to take over. All default OFF. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Switch to Spotify on playback"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Show the Spotify page when a cast starts"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTakeoverPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Wake and show Rusty on playback"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTakeoverShowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Light the screen and open over other apps when a cast starts"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTakeoverShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:minHeight="0dp"
                android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
                app:switchMinWidth="0dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <!-- Only visible while the merged toggle is on but "Display over other apps" is not
             granted. Same row idiom as rowBrightnessPermission in the General panel. -->
        <LinearLayout
            android:id="@+id/rowOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hanken_medium"
                android:text="Allow display over other apps"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="›"
                android:textColor="@color/muted_dim"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DURING MESSAGES -->

    <include
        android:id="@+id/headSpMessages"
        layout="@layout/view_settings_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bodySpMessages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Mix mode: what happens to Spotify audio while a message/announcement plays. The choices
             reflow to a second line when the card is too narrow (portrait / small window) instead of
             spilling off the right edge — same ConstraintLayout Flow the Screensaver theme picker
             uses. Deliberately NOT a RadioGroup: it only auto-manages its DIRECT children, and
             Flow-positioned radios are not that, so mutual exclusion is enforced in the binder. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_medium"
            android:text="Behaviour"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="rbMixPause,rbMixDuck"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="24dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="6dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbMixPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Pause"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbMixDuck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_fallback"
                android:fontFamily="@font/hanken_regular"
                android:foreground="@drawable/bg_tv_focus_switch"
                android:text="Lower volume"
                android:textColor="@color/ink" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <!-- Volume fade: how quickly Spotify fades out before a message and back in after it.
             Reflows to a second line on a narrow card, like the mix-mode row above (not a RadioGroup). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Volume fade"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="rbFadeOff,rbFadeShort,rbFadeMedium,rbFadeLong"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="16dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="6dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioButton
                    android:id="@+id/rbFadeOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="Off"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbFadeShort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="0.25s"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbFadeMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="0.5s"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbFadeLong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_fallback"
                    android:fontFamily="@font/hanken_regular"
                    android:foreground="@drawable/bg_tv_focus_switch"
                    android:text="1s"
                    android:textColor="@color/ink" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/hanken_regular"
            android:text="Spotify fades out before a message starts and fades back in after it ends."
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
