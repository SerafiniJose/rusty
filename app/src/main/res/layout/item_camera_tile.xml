<?xml version="1.0" encoding="utf-8"?>
<!--
  One grid tile: 16:9 snapshot + bottom gradient carrying a coloured status dot, the camera name
  and — only while UNREACHABLE — a plain "Offline for 12 min" sentence over a dimmed last frame.
  A placeholder glyph stands in when no snapshot has ever been fetched (state NONE). Focus ring
  is the app's existing D-pad focus indicator (bg_tv_focus), applied as android:foreground so the
  ripple/selectable background underneath is preserved.

  The 16:9 ratio lives on tileImage, NOT on tileRoot: this layout is inflated as a RecyclerView item,
  so the root's LayoutParams are the GridLayoutManager's — app:layout_constraintDimensionRatio is a
  ConstraintLayout.LayoutParams attribute and is silently ignored there, which left the root at its
  literal 0dp height and made every tile invisible. The root wraps its content instead, and the
  image (width 0dp = the fixed column width, height 0dp + ratio) is what gives the tile its height.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tileRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@color/surface"
    android:foreground="@drawable/bg_tv_focus"
    android:focusable="true"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false">

    <ImageView
        android:id="@+id/tileImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:9"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Placeholder glyph: visible only when the camera has never produced a frame (TileState.NONE). -->
    <ImageView
        android:id="@+id/tilePlaceholder"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_mdi_cctv"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/tileBottomScrim"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_tile_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/tileDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_status_dot"
        app:layout_constraintBottom_toBottomOf="@id/tileBottomScrim"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintBottom_toBottomOf="@id/tileBottomScrim"
        app:layout_constraintStart_toEndOf="@id/tileDot"
        app:layout_constraintEnd_toStartOf="@id/tileOffline"
        tools:text="Front Door" />

    <TextView
        android:id="@+id/tileOffline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="7dp"
        android:textColor="@color/dot_red"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tileBottomScrim"
        app:layout_constraintStart_toEndOf="@id/tileName"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Offline for 12 min" />

</androidx.constraintlayout.widget.ConstraintLayout>
