<?xml version="1.0" encoding="utf-8"?>
<!-- One configured camera in the Cameras section. Whole row opens the edit dialog. The status dot and sub-line are live: CameraSettingsPanel paints them from CameraStatusRelay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_tv_focus"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/dotCamRowStatus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_status_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCamRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_medium"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCamRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_regular"
            android:maxLines="1"
            android:textColor="@color/muted_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/hanken_regular"
        android:importantForAccessibility="no"
        android:text="›"
        android:textColor="@color/muted_dim"
        android:textSize="18sp" />
</LinearLayout>
