<?xml version="1.0" encoding="utf-8"?>
<!-- Asks for a discovered camera's credentials before OnvifClient.resolve is called. Same masked-
     input card idiom as dialog_control_password.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCamCredTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hanken_semibold"
        android:text="Camera credentials"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/muted_dim"
        app:boxStrokeColor="@color/accent_fallback"
        app:hintTextColor="@color/muted_dim">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCamCredUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_regular"
            android:hint="Username"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColorHint="@color/muted_dim"
        app:boxStrokeColor="@color/accent_fallback"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/muted_dim"
        app:hintTextColor="@color/muted_dim">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCamCredPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hanken_regular"
            android:hint="Password"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamCredCancel"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamCredSave"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Connect" />
    </LinearLayout>
</LinearLayout>
