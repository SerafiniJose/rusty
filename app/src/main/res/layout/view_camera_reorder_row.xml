<?xml version="1.0" encoding="utf-8"?>
<!-- One camera while the Cameras section is in reorder mode. Number = list position; subline =
     where that lands on the wall (CameraOrder.positionLabel). The whole row is the D-pad
     stop: centre lifts it, ▲/▼ move it, centre drops it. The handle takes touch drags. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowCamReorderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_camera_reorder_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_tv_focus"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvCamReorderIndex"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hanken_medium"
        android:textColor="@color/muted_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCamReorderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_medium"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCamReorderSpot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/hanken_regular"
            android:maxLines="1"
            android:textColor="@color/muted_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnCamReorderHandle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Drag to move"
        android:padding="10dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/muted_dim" />
</LinearLayout>
