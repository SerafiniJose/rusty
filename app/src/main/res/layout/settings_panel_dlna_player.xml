<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Player power: live status sub-line + a Start/Stop toggle (mirrors the Spotify receiver row). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="DLNA player"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDlnaStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:maxLines="1"
                android:text="Stopped"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleDlna"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Start" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/surface_border" />

    <!-- Player name: current name + a Change button that reveals the editor. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Player name"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDlnaNameValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:maxLines="1"
                android:text="Rusty Media Player"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeDlnaName"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Change" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDlnaNameEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDlnaName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColorHint="@color/muted_dim"
            app:boxStrokeColor="@color/accent_fallback"
            app:hintTextColor="@color/muted_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDlnaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDlnaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Save"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_fallback" />
    </LinearLayout>

    <!-- Address: only shown while the player is running on a reachable network. -->
    <LinearLayout
        android:id="@+id/rowDlnaAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="Address"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDlnaAddressValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/hanken_regular"
                    android:maxLines="1"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyDlnaAddress"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Copy" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDlnaFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
