<?xml version="1.0" encoding="utf-8"?>
<!-- Remote Control tab: the control API's own settings. Present in the tab strip exactly while
     the API toggle in General is on (settingsTabsFor), like the Slideshow tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Control page: where the remote lives, and a QR code so a phone can get there. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hanken_regular"
        android:letterSpacing="0.12"
        android:text="CONTROL PAGE"
        android:textAllCaps="true"
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Address"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvControlPageAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="Waiting for network"
                android:textColor="@color/muted_dim"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowControlQr"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Show QR" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:text="Open it in a browser on the same Wi-Fi, or scan the code with a phone."
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/surface_border" />

    <!-- Access -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/hanken_regular"
        android:letterSpacing="0.12"
        android:text="ACCESS"
        android:textAllCaps="true"
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />

    <!-- Require-password switch; the sub-line says what off actually means. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Require password"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvControlAuthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="Off — anyone on your network can control this device"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchControlAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:foreground="@drawable/bg_tv_focus_switch"
            android:minHeight="0dp"
            android:theme="@style/ThemeOverlay.Rusty.SwitchNoHalo"
            app:switchMinWidth="0dp"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackTint="@color/switch_track_tint" />
    </LinearLayout>

    <!-- Password value + Change, the Announcement-voice row pattern. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Password"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvControlPasswordValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="Not set"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeControlPassword"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Change" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:text="Required by the control page and the Home Assistant integration."
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/surface_border" />

    <!-- Announcements -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/hanken_regular"
        android:letterSpacing="0.12"
        android:text="ANNOUNCEMENTS"
        android:textAllCaps="true"
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />

    <!-- Announcement voice: the ONE voices row. Manage opens the card that holds everything —
         the selectable voices, the quality tier (as filter chips over the catalog), and the
         downloadable Piper catalog. The label sits in a weighted column so a narrow card never
         squeezes it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_medium"
                android:text="Announcement voice"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTtsVoiceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:maxLines="2"
                android:text="System default"
                android:textColor="@color/muted_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeTtsVoice"
            style="@style/Widget.Rusty.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_tv_focus"
            android:text="Manage" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRemoteControlFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
