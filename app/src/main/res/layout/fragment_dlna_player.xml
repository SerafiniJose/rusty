<?xml version="1.0" encoding="utf-8"?>
<!--
  DLNA Player face — a visual twin of the Spotify Now Playing screen (fragment_spotify.xml).
  Landscape variant: art card left, info + transport right. No blurred-art wash/scrim layers:
  DLNA senders rarely broadcast album art, so the card usually shows the gradient + DLNA glyph
  placeholder and a wash would just be a blurry gradient. The mesh + grain run in every state.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dlnaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Layer 1: drifting mesh -->
    <dev.rusty.app.AmbientMeshView
        android:id="@+id/dlnaMesh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Layer 2: grain -->
    <dev.rusty.app.GrainView
        android:id="@+id/dlnaGrain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Foreground content. The fragment pads THIS (system-bar insets), so the background
         layers above stay full-bleed to the window edges. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dlnaContentLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top-left identity: dot + device name + suffix (now-playing states only) -->
        <LinearLayout
            android:id="@+id/dlnaIdentityRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dlnaIdentityDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/dlnaIdentityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_semibold"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="· DLNA"
                android:textColor="@color/muted_dim"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- STOPPED / STARTING / FAILED / READY share this status block -->
        <LinearLayout
            android:id="@+id/dlnaStatusBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/ic_mdi_dlna" />

            <TextView
                android:id="@+id/dlnaStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/hanken_semibold"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/dlnaStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/hanken_regular"
                android:gravity="center"
                android:textColor="@color/muted_dim"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dlnaStartButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Start"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Playing group: cover left, info right (mirrors the Spotify split) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dlnaAlbumArtCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/dlnaAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_album_art_placeholder"
                android:contentDescription="Album art"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/dlnaArtGlyph"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/ic_mdi_dlna" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/dlnaNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/dlnaAlbumArtCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dlnaAlbumArtCard"
            app:layout_constraintTop_toTopOf="@id/dlnaAlbumArtCard">

            <TextView
                android:id="@+id/dlnaEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_semibold"
                android:letterSpacing="0.18"
                android:text="NOW PLAYING"
                android:textColor="@color/accent_fallback"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlnaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/bricolage_bold"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/dlnaArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/dlnaAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/hanken_regular"
                android:maxLines="1"
                android:textColor="@color/muted_dim"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/dlnaProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@null"
                android:focusable="false"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/bg_dlna_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/bg_dlna_seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dlnaElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/hanken_regular"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dlnaDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/dlnaStop"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Stop"
                    android:foreground="@drawable/bg_tv_focus"
                    android:nextFocusRight="@id/dlnaPlayPause"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop" />

                <ImageButton
                    android:id="@+id/dlnaPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="22dp"
                    android:background="@drawable/bg_playpause_button"
                    android:contentDescription="Play or pause"
                    android:foreground="@drawable/bg_tv_focus"
                    android:nextFocusLeft="@id/dlnaStop"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
