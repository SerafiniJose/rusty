<?xml version="1.0" encoding="utf-8"?>
<!-- Single-choice picker for the announcement voice QUALITY, the tier the downloadable catalog
     is offered at. Four rows, built in code from VoiceQuality so the vocabulary lives in one
     place; the card wraps its content rather than filling the window, unlike the voice picker
     whose list can be long. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/hanken_semibold"
            android:text="Voice quality"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnQualityClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/muted_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/llQualityRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/hanken_regular"
        android:text="Quality decides which voices are offered to download, not how the ones you already downloaded sound — those stay exactly as they are."
        android:textColor="@color/muted_dim"
        android:textSize="12sp" />
</LinearLayout>
