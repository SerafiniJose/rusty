<?xml version="1.0" encoding="utf-8"?>
<!-- Services & status: the app-wide info page. Header + aggregate summary, then three runtime
     service rows (Spotify Connect, DLNA Player, Remote Control) inflated into llInfoServices, then
     the configured integrations inflated into llInfoFeatures, then the About & updates row.
     The features divider + header are hidden together when there is no connected feature.
     Height is capped at ~82% of the display by MaxHeightNestedScrollView so the card stays
     dismissible in every orientation. -->
<dev.rusty.app.MaxHeightNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infoScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvInfoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_bold"
            android:text="Services &amp; status"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <!-- Aggregate runtime summary, e.g. "2 services running · 1 off". Bound at runtime. -->
        <TextView
            android:id="@+id/tvInfoSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/hanken_regular"
            android:text=""
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- Service rows (item_info_service) are inflated here, in spec order. -->
        <LinearLayout
            android:id="@+id/llInfoServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <View
            android:id="@+id/viewInfoFeaturesDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface_border" />

        <TextView
            android:id="@+id/tvInfoFeaturesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/hanken_regular"
            android:letterSpacing="0.12"
            android:text="CONNECTED FEATURES"
            android:textAllCaps="true"
            android:textColor="@color/muted_dim"
            android:textSize="12sp" />

        <!-- Feature rows (item_info_feature) are inflated here; empty when nothing is configured. -->
        <LinearLayout
            android:id="@+id/llInfoFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface_border" />

        <!-- About & updates: tappable row showing the running version + an "Update" badge
             when a newer release is found; opens the About sheet. -->
        <LinearLayout
            android:id="@+id/rowAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_medium"
                    android:text="About &amp; updates"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAboutValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanken_regular"
                    android:text="Version 1.1.0"
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpdateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_update_badge"
                android:fontFamily="@font/hanken_medium"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Update"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="›"
                android:textColor="@color/muted_dim"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</dev.rusty.app.MaxHeightNestedScrollView>
