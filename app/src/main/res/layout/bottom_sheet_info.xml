<?xml version="1.0" encoding="utf-8"?>
<!-- Services & status: the app-wide info page. Header + aggregate summary with the version chip
     (About & updates) on its right, then four runtime service rows (Spotify Connect, DLNA Player,
     Remote Control, Camera share) inflated into llInfoServices, then the configured integrations
     inflated into llInfoFeatures.
     The features divider + header are hidden together when there is no connected feature.
     Height is capped at ~82% of the display by MaxHeightNestedScrollView so the card stays
     dismissible in every orientation. -->
<dev.rusty.app.MaxHeightNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infoScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Title beside the chip; InfoSheet stacks the chip under the title on a narrow screen. -->
        <LinearLayout
            android:id="@+id/layInfoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layInfoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInfoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_bold"
                    android:text="Services &amp; status"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <!-- Aggregate runtime summary, e.g. "2 services running · 1 off". Bound at runtime. -->
                <TextView
                    android:id="@+id/tvInfoSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/hanken_regular"
                    android:text=""
                    android:textColor="@color/muted_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- "About · v2.8.0 ›", or "● Update 2.9.0 ›" while an update is available: the way into
                 About & updates, always shown. Styled and labelled at runtime. -->
            <TextView
                android:id="@+id/tvInfoVersionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_version_pill"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:fontFamily="@font/hanken_medium"
                android:foreground="@drawable/bg_tv_focus"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Service rows (item_info_service) are inflated here, in spec order. -->
        <LinearLayout
            android:id="@+id/llInfoServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <View
            android:id="@+id/viewInfoFeaturesDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface_border" />

        <TextView
            android:id="@+id/tvInfoFeaturesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/hanken_regular"
            android:letterSpacing="0.12"
            android:text="CONNECTED FEATURES"
            android:textAllCaps="true"
            android:textColor="@color/muted_dim"
            android:textSize="12sp" />

        <!-- Feature rows (item_info_feature) are inflated here; empty when nothing is configured. -->
        <LinearLayout
            android:id="@+id/llInfoFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</dev.rusty.app.MaxHeightNestedScrollView>
