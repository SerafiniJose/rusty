<?xml version="1.0" encoding="utf-8"?>
<!-- One slide layer's content: two panes. Pane 2 is GONE unless split view pairs two portraits.
     Each pane's wash+photo live in an ifZoom* container which is the Ken Burns target, so the zoom
     animator and the crossfade alpha animator never share a ViewPropertyAnimator, AND the caption
     (a sibling of the zoom container, not a child) stays pinned to its corner while the photo
     scales past it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <FrameLayout
        android:id="@+id/ifPane1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/ifZoom1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ifWash1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.6"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/ifPhoto1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/ifCaption1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:background="@drawable/bg_caption_scrim"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/hanken_regular"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ifPane2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/ifZoom2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ifWash2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.6"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/ifPhoto2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/ifCaption2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:background="@drawable/bg_caption_scrim"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/hanken_regular"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
