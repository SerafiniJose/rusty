<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Header: app name + running version, centered. With an update the version line reads
             "Version 2.6.0 → 2.7.0" and the release line below it appears. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_bold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvAboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/hanken_regular"
            android:gravity="center"
            android:text="Version 1.1.0"
            android:textColor="@color/muted_dim"
            android:textSize="14sp" />

        <!-- "Released 21 Sep · 75 MB download": shown only with an update. -->
        <TextView
            android:id="@+id/tvReleaseMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/hanken_regular"
            android:gravity="center"
            android:textColor="@color/muted_dim"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Status line: checking, up to date, couldn't check, or an install failure. -->
        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/hanken_regular"
            android:gravity="center"
            android:text="Checking for updates…"
            android:textColor="@color/muted_dim"
            android:textSize="13sp" />

        <!-- Update: installs in-app (or opens the release page). Shown only when an update exists,
             and first in the card so a remote lands on it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:foreground="@drawable/bg_tv_focus"
            android:fontFamily="@font/hanken_medium"
            android:text="Update"
            android:letterSpacing="0"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/accent_fallback"
            android:visibility="gone" />

        <!-- What's new: the release's sections (built at runtime into llWhatsNew), or the notes as
             plain text when they have no structure to read. Shown only with an update. -->
        <LinearLayout
            android:id="@+id/layWhatsNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/hanken_medium"
                    android:text="What's new"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsNewDetails"
                    style="@style/Widget.Rusty.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/bg_tv_focus"
                    android:text="Show details"
                    android:letterSpacing="0"
            android:textAllCaps="false"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/hanken_regular"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/muted_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- When the answer is from, and Check now to ask GitHub again straight away (the app
             otherwise checks once a day). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCheckedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/hanken_regular"
                android:textColor="@color/muted_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckNow"
                style="@style/Widget.Rusty.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/bg_tv_focus"
                android:text="Check now"
                android:letterSpacing="0"
            android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface_border" />

        <!-- Source & releases: always available, opens the repo. -->
        <LinearLayout
            android:id="@+id/rowSource"
            android:paddingHorizontal="@dimen/tv_focus_ring_gap"
            android:layout_marginHorizontal="@dimen/tv_focus_ring_gap_offset"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hanken_medium"
                android:text="Source &amp; releases"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="›"
                android:textColor="@color/muted_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/surface_border" />

        <!-- Report an issue: always available, opens the GitHub issue tracker. -->
        <LinearLayout
            android:id="@+id/rowReportIssue"
            android:paddingHorizontal="@dimen/tv_focus_ring_gap"
            android:layout_marginHorizontal="@dimen/tv_focus_ring_gap_offset"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:foreground="@drawable/bg_tv_focus"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hanken_medium"
                android:text="Report an issue"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hanken_regular"
                android:text="›"
                android:textColor="@color/muted_dim"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
